classDiagram
    class Library {
        add_book()
        register_user()
        create_loan()
    }

    class Book {
        str title
        str author
        bool state
        mark_as_unavailable()
        mark_as_available()
    }

    class User {
        str name
        str email
    }

    class Loan {
        str start_date
        str end_date
        close_loan()
    }

    Library "0..1" o-- "0..*" Book : manages
    Library "0..1" o-- "0..*" User : registers
    Library "1" *-- "0..*" Loan : manages
    Loan "0..*" --> "1" Book : references
    Loan "0..*" --> "1" User : references
